{
  "name": "earforge",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "e2e:browser": "browsers install chrome@stable --path e2e/.cache/browsers",
    "check": "oxlint --deny-warnings && vitest run && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
